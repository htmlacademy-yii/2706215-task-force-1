# Application variables.
# See .env.mysql for MySQL container initialization variables.

APP_URL=http://localhost:8080
APP_PORT=8080

# Database connection
#
# Default: PHP runs inside Docker.
# To run PHP locally on the host, use localhost and the published MySQL port instead.

DB_HOST=taskforce-yii2-mysql
DB_PORT=3306

# Local PHP alternative:
# DB_HOST=localhost
# DB_PORT=3309

DB_NAME=
DB_USER=
DB_PASSWORD=

COOKIE_VALIDATION_KEY=

# Yandex APIs (required for geocoding/address suggestions and maps)
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_API_KEY=

# GitHub APIs (required for GitHub authorization)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
